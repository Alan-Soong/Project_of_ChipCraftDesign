  <property name="windowTitle">
   <string>芯片属性编辑器</string>
  </property>
  <property name="styleSheet">
   <string notr="true">/* 对话框整体样式 */
QDialog {
    background-color: #faf9f8;
    font-family: "Segoe UI", "Microsoft YaHei";
    font-size: 14px;
}

/* 标签样式 */
QLabel {
    color: #323130;
    font-weight: 500;
    padding: 8px 4px;
}

/* 输入框样式 */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 2px solid #e1dfdd;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
    color: #323130;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #0078d4;
    outline: none;
}

QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #c8c6c4;
}

/* 组合框样式 */
QComboBox {
    background-color: #ffffff;
    border: 2px solid #e1dfdd;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
    color: #323130;
    min-width: 120px;
}

QComboBox:focus {
    border-color: #0078d4;
}

QComboBox:hover {
    border-color: #c8c6c4;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTYiIGhlaWdodD0iMTYiIHZpZXdCb3g9IjAgMCAxNiAxNiIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHBhdGggZD0iTTQgNkw4IDEwTDEyIDYiIHN0cm9rZT0iIzMyMzEzMCIgc3Ryb2tlLXdpZHRoPSIyIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz4KPC9zdmc+);
}

/* 复选框样式 */
QCheckBox {
    color: #323130;
    font-size: 14px;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #e1dfdd;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #0078d4;
    border-color: #0078d4;
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTYiIGhlaWdodD0iMTYiIHZpZXdCb3g9IjAgMCAxNiAxNiIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHBhdGggZD0iTTEzIDRMNiAxMUwzIDgiIHN0cm9rZT0iI2ZmZmZmZiIgc3Ryb2tlLXdpZHRoPSIyIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz4KPC9zdmc+);
}

/* 按钮样式 */
QPushButton {
    background-color: #ffffff;
    border: 2px solid #e1dfdd;
    border-radius: 6px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 500;
    color: #323130;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #f3f2f1;
    border-color: #c8c6c4;
}

QPushButton:pressed {
    background-color: #edebe9;
    border-color: #a19f9d;
}

QPushButton:focus {
    border-color: #0078d4;
    outline: none;
}

/* 主要按钮样式 */
QPushButton#saveButton {
    background-color: #0078d4;
    color: #ffffff;
    border-color: #0078d4;
}

QPushButton#saveButton:hover {
    background-color: #106ebe;
    border-color: #106ebe;
}

QPushButton#addPinButton {
    background-color: #107c10;
    color: #ffffff;
    border-color: #107c10;
}

QPushButton#addPinButton:hover {
    background-color: #0e6e0e;
    border-color: #0e6e0e;
}

QPushButton#removePinButton {
    background-color: #d13438;
    color: #ffffff;
    border-color: #d13438;
}

QPushButton#removePinButton:hover {
    background-color: #b4282c;
    border-color: #b4282c;
}

/* 列表视图样式 */
QListView {
    background-color: #ffffff;
    border: 2px solid #e1dfdd;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #f3f2f1;
}

QListView::item {
    padding: 8px;
    border-radius: 4px;
    margin: 2px;
}

QListView::item:selected {
    background-color: #e8f4fd;
    color: #323130;
}

QListView::item:hover {
    background-color: #f3f2f1;
}

/* 图形视图样式 */
QGraphicsView {
    background-color: #ffffff;
    border: 2px solid #e1dfdd;
    border-radius: 6px;
}

QGraphicsView:focus {
    border-color: #0078d4;
}</string>
