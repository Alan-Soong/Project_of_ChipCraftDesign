  <property name="styleSheet">
   <string notr="true">/* 经典风格 + 轻度色彩点缀 */
QMainWindow { background: #e9eef3; color: #1f2937; }

QMenuBar { background: #ffffff; border-bottom: 1px solid #d0d7de; }
QMenu { background: #ffffff; border: 1px solid #d0d7de; }
QMenuBar::item { padding: 4px 10px; }
QMenu::item { padding: 4px 16px; }
QMenu::item:selected { background: #e6f0ff; }

QDockWidget { background: #f7fafc; border: 1px solid #d0d7de; }
QDockWidget::title { background: #eef5ff; padding: 6px; font-weight: 600; color: #0f4c81; }

QToolBar {
    background: qlineargradient(y1:0, y2:1, stop:0 #f7fafc, stop:1 #eef5ff);
    border-bottom: 1px solid #b6c5d5;
    spacing: 6px;
}
QToolButton { padding: 4px; border: 1px solid transparent; }
QToolButton:hover { background: #e6f0ff; border-color: #b6c5d5; }
QToolButton:pressed { background: #d9e8ff; border-color: #94a9c4; }

QStatusBar { background: #ffffff; border-top: 1px solid #d0d7de; }

QPushButton { background: #ffffff; border: 1px solid #d0d7de; padding: 4px 8px; }
QPushButton:hover { background: #f3f8ff; border-color: #b6c5d5; }
QPushButton:pressed { background: #e6f0ff; border-color: #94a9c4; }

QGraphicsView { background: #ffffff; border: 1px solid #c0c0c0; }</string>
