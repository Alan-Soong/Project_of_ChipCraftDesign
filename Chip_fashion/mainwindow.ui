  <property name="styleSheet">
   <string notr="true">/* 主窗口样式 */
QMainWindow {
    background-color: #f3f3f3;
    color: #323130;
}

/* 菜单栏样式 */
QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e1dfdd;
    font-size: 14px;
    padding: 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 8px 16px;
    margin: 0px 2px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #f3f2f1;
    color: #323130;
}

QMenuBar::item:pressed {
    background-color: #edebe9;
}

/* 菜单样式 */
QMenu {
    background-color: #ffffff;
    border: 1px solid #e1dfdd;
    border-radius: 8px;
    padding: 8px 0px;
    font-size: 14px;
}

QMenu::item {
    padding: 8px 24px;
    margin: 2px 8px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #f3f2f1;
    color: #323130;
}

/* 停靠窗口样式 */
QDockWidget {
    background-color: #faf9f8;
    border: 1px solid #e1dfdd;
    border-radius: 8px;
    font-size: 14px;
}

QDockWidget::title {
    background-color: #ffffff;
    border-bottom: 1px solid #e1dfdd;
    padding: 12px;
    font-weight: 600;
    color: #323130;
}</string>
