    <property name="styleSheet">
     <string notr="true">/* 工具箱按钮样式 */
QPushButton {
    background-color: #ffffff;
    border: 2px solid #e1dfdd;
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 14px;
    font-weight: 500;
    color: #323130;
    text-align: left;
    min-height: 32px;
}

QPushButton:hover {
    background-color: #f3f2f1;
    border-color: #c8c6c4;
}

QPushButton:pressed {
    background-color: #edebe9;
    border-color: #a19f9d;
}

QPushButton:focus {
    border-color: #0078d4;
    outline: none;
}

/* 特殊按钮颜色 */
QPushButton#addRectangleButton {
    background-color: #0078d4;
    color: #ffffff;
    border-color: #0078d4;
}

QPushButton#addRectangleButton:hover {
    background-color: #106ebe;
    border-color: #106ebe;
}

QPushButton#deleteButton {
    background-color: #d13438;
    color: #ffffff;
    border-color: #d13438;
}

QPushButton#deleteButton:hover {
    background-color: #b4282c;
    border-color: #b4282c;
}</string>
