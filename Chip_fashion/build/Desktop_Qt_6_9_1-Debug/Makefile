####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/ChipDesign_Refactored/bin || mkdir -p $(INSTALL_ROOT)/opt/ChipDesign_Refactored/bin
	$(QINSTALL_PROGRAM) build/debug/$(QMAKE_TARGET) $(INSTALL_ROOT)/opt/ChipDesign_Refactored/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/ChipDesign_Refactored/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/ChipDesign_Refactored/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

